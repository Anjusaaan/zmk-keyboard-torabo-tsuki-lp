#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer indices. Held layers come first, then the trackball layers.
// Written for the S physical layout: 44 keys, 5+5 / 5+5 / 6+6 / 6+6.
// The two centre columns only exist on the bottom two rows.
// MOUSE / SCROLL must match AUTO_MOUSE_LAYER / SCROLL_LAYER in
// boards/shields/torabo_tsuki_lp/torabo_tsuki_lp_right.overlay.
#define BASE   0
#define SYM    1
#define NAV    2
#define MOUSE  3
#define SCROLL 4

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <13 14>;
            layers = <SYM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: BASE
        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q      &kp W     &kp E     &kp R     &kp T                                                            &kp Y          &kp U     &kp I      &kp O     &kp P
&kp A      &kp S     &kp D     &kp F     &kp G                                                            &kp H          &kp J     &kp K      &kp L     &kp SEMI
&kp Z      &kp X     &kp C     &kp V     &kp B          &kp SPACE                  &kp RET                &kp N          &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH
&kp LCTRL  &kp LGUI  &kp LALT  &kp BSPC  &lt SYM SPACE  &mt LEFT_SHIFT LANGUAGE_1  &mt RSHIFT LANGUAGE_2  &lt NAV ENTER  &kp BSPC  &kp RALT   &kp RGUI  &kp RCTRL
            >;
        };

        // 1: SYM - numbers and symbols. Held with the left thumb (&lt SYM SPACE).
        sym_layer {
            display-name = "SYM";
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(N6)      &kp LS(N7)     &kp LS(N8)        &kp LS(N9)         &kp LS(N0)
&kp N1            &kp N2            &kp N3      &kp N4      &kp N5                      &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON
&kp N6            &kp N7            &kp N8      &kp N9      &kp N0      &trans  &trans  &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans            &trans            &trans      &trans      &trans      &trans  &trans  &kp TAB         &kp DEL        &trans            &trans             &trans
            >;
        };

        // 2: NAV - function keys, arrows and radio control. Held with the right
        // thumb (&lt NAV ENTER).
        nav_layer {
            display-name = "NAV";
            bindings = <
&kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE
&kp F6   &kp F7   &kp F8        &kp F9        &kp F10                     &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB
&kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE
&trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans
            >;
        };

        // 3: MOUSE - auto mouse layer. Entered automatically by moving the
        // trackball (see zip_temp_layer in torabo_tsuki_lp_right.overlay).
        // &mo SCROLL sits on the left centre key of the Z row (position 25),
        // the topmost centre key the S layout has.
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans     &trans     &trans     &trans                      &trans  &trans     &trans     &trans     &trans
&trans  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans                      &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans     &trans     &trans     &trans  &mo SCROLL  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans     &trans     &trans     &trans  &trans      &trans  &trans  &trans     &trans     &trans     &trans
            >;
        };

        // 4: SCROLL - held from MOUSE; trackball movement becomes wheel movement
        // (see the "scroller" override in torabo_tsuki_lp_right.overlay).
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans     &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans
&trans  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans                  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
            >;
        };
    };
};
